-- ============================================================
-- LIGHTING OPTIMIZER
-- ============================================================
local LightingOptimizer = {
    optimize = function(preset: Preset)
        local props = {"GlobalShadows", "Brightness", "Ambient", "OutdoorAmbient", "EnvironmentDiffuseScale", "EnvironmentSpecularScale", "FogStart", "FogEnd"}
        for _, prop in ipairs(props) do
            StateStore:save(Lighting, prop, (Lighting :: any)[prop])
        end

        if preset.globalShadows ~= nil then
            Lighting.GlobalShadows = preset.globalShadows
        end
        if preset.brightness ~= nil then
            Lighting.Brightness = preset.brightness
        end
        if preset.name == "EXTREMO" or preset.name == "ULTRA BATATA" then
            Lighting.EnvironmentDiffuseScale = 0
            Lighting.EnvironmentSpecularScale = 0
        elseif preset.name == "BALANCEADO" then
            Lighting.EnvironmentDiffuseScale = 0.5
            Lighting.EnvironmentSpecularScale = 0.5
        end

        for _, obj in ipairs(Lighting:GetChildren()) do
            if obj:IsA("PostEffect") then
                StateStore:save(obj, "Enabled", obj.Enabled)
                if preset.disablePostEffects then
                    obj.Enabled = false
                elseif preset.name == "BALANCEADO" then
                    if obj:IsA("BloomEffect") or obj:IsA("BlurEffect") or obj:IsA("SunRaysEffect") or obj:IsA("DepthOfFieldEffect") then
                        obj.Enabled = false
                    else
                        obj.Enabled = true
                    end
                else
                    obj.Enabled = true
                end
            elseif obj:IsA("Atmosphere") then
                StateStore:save(obj, "Density", obj.Density)
                if preset.disableAtmosphere then
                    obj.Density = 0
                end
            end
        end
    end,
}

-- ============================================================
-- PARTICLE OPTIMIZER
-- ============================================================
local ParticleOptimizer = {
    optimizeVisualEffect = function(obj: Instance, preset: Preset)
        local function saveAndSet(instance: Instance, value: boolean)
            local inst = instance :: any
            if inst.Enabled ~= nil then
                StateStore:save(instance, "Enabled", inst.Enabled)
                inst.Enabled = value
            end
        end

        if obj:IsA("ParticleEmitter") then
            saveAndSet(obj, not preset.disableParticles)
            if preset.reduceParticles and not preset.disableParticles then
                StateStore:save(obj, "Rate", obj.Rate)
                obj.Rate = math.min(obj.Rate, 10)
            end
            if preset.disableParticles then
                pcall(function() obj:Clear() end)
            end
        elseif obj:IsA("Trail") or obj:IsA("Beam") then
            saveAndSet(obj, not preset.disableParticles)
        elseif obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles") then
            saveAndSet(obj, not preset.disableParticles)
        end
    end,
}

-- ============================================================
-- MATERIAL / TEXTURE OPTIMIZER
-- ============================================================
local MaterialOptimizer = {
    optimizePart = function(part: BasePart, preset: Preset)
        if preset.simplifyMaterials then
            StateStore:save(part, "Material", part.Material)
            StateStore:save(part, "Reflectance", part.Reflectance)
            part.Material = Enum.Material.SmoothPlastic
            part.Reflectance = 0
        end
        if preset.stripTextures then
            if part:IsA("MeshPart") then
                StateStore:save(part, "TextureID", part.TextureID)
                part.TextureID = ""
            end
            for _, child in ipairs(part:GetChildren()) do
                if child:IsA("Decal") or child:IsA("Texture") then
                    StateStore:save(child, "Transparency", child.Transparency)
                    child.Transparency = 1
                elseif child:IsA("SurfaceAppearance") then
                    StateStore:save(child, "Enabled", child.Enabled)
                    child.Enabled = false
                end
            end
        end
    end,
}

-- ============================================================
-- TERRAIN OPTIMIZER
-- ============================================================
local TerrainOptimizer = {
    optimize = function(preset: Preset)
        local props = {"WaterWaveSize", "WaterWaveSpeed", "WaterReflectance", "WaterTransparency"}
        for _, prop in ipairs(props) do
            StateStore:save(Terrain, prop, (Terrain :: any)[prop])
        end
        if preset.simplifyWater then
            Terrain.WaterWaveSize = 0
            Terrain.WaterWaveSpeed = 0
            Terrain.WaterReflectance = 0
            Terrain.WaterTransparency = 0.3
        end
    end,
}

-- ============================================================
-- OBJECT TRACKER
-- Uma única conexão global para novos objetos relevantes.
-- ============================================================
local ObjectTracker = {
    _connection = nil :: RBXScriptConnection?,

    processNewObject = function(obj: Instance)
        local preset = PresetManager:get()
        if obj:IsA("BasePart") then
            MaterialOptimizer.optimizePart(obj, preset)
        elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles") then
            ParticleOptimizer.optimizeVisualEffect(obj, preset)
        elseif obj:IsA("Light") and preset.aggressiveLights then
            StateStore:save(obj, "Enabled", obj.Enabled)
            obj.Enabled = false
        elseif obj:IsA("PostEffect") then
            StateStore:save(obj, "Enabled", obj.Enabled)
            obj.Enabled = not preset.disablePostEffects
        end
    end,

    start = function(self)
        if self._connection then return end
        self._connection = Workspace.DescendantAdded:Connect(function(obj)
            self.processNewObject(obj)
        end)
    end,

    stop = function(self)
        if self._connection then
            self._connection:Disconnect()
            self._connection = nil
        end
    end,
}

-- ============================================================
-- OPTIMIZATION MANAGER
-- ============================================================
local OptimizationManager = {
    _isApplying = false,
    _processedCount = 0,

    _processBatch = function(self, objs: {Instance}, preset: Preset)
        for _, obj in ipairs(objs) do
            if obj.Parent == nil then continue end
            if obj:IsA("BasePart") then
                MaterialOptimizer.optimizePart(obj, preset)
                self._processedCount += 1
            elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles") then
                ParticleOptimizer.optimizeVisualEffect(obj, preset)
                self._processedCount += 1
            elseif obj:IsA("Light") and preset.aggressiveLights then
                StateStore:save(obj, "Enabled", obj.Enabled)
                obj.Enabled = false
                self._processedCount += 1
            end
        end
    end,

    apply = function(self, presetName: string)
        if self._isApplying then return end
        self._isApplying = true

        StateStore:restoreAll()
        PresetManager:set(presetName)
        local preset = PresetManager:get()

        LightingOptimizer.optimize(preset)
        TerrainOptimizer.optimize(preset)

        self._processedCount = 0
        local descendants = Workspace:GetDescendants()
        local total = #descendants

        for i = 1, total, BATCH_SIZE do
            local batch = {}
            for j = i, math.min(i + BATCH_SIZE - 1, total) do
                table.insert(batch, descendants[j])
            end
            self:_processBatch(batch, preset)
            task.wait()
        end

        if preset.targetFps then
            pcall(function()
                if setfpscap then
                    setfpscap(preset.targetFps)
                end
            end)
        end

        ObjectTracker:stop()
        ObjectTracker:start()

        self._isApplying = false
    end,
}

-- ============================================================
-- PERFORMANCE MONITOR (FPS real)
-- ============================================================
local PerformanceMonitor = {
    _fps = 0,
    _frameCount = 0,
    _lastSampleTime = os.clock(),
    _samples = {} :: { number },

    start = function(self, callback: (number) -> ())
        RunService.RenderStepped:Connect(function()
            self._frameCount += 1
            local now = os.clock()
            local elapsed = now - self._lastSampleTime
            if elapsed >= FPS_SAMPLE_INTERVAL then
                local fps = self._frameCount / elapsed
                self._frameCount = 0
                self._lastSampleTime = now

                table.insert(self._samples, fps)
                while #self._samples > FPS_SMOOTH_SAMPLES do
                    table.remove(self._samples, 1)
                end
                local sum = 0
                for _, v in ipairs(self._samples) do
                    sum += v
                end
                self._fps = sum / #self._samples
                callback(self._fps)
            end
        end)
    end,

    getFps = function(self): number
        return self._fps
    end,
}

