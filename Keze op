local FPS_SMOOTH_SAMPLES = 4

-- ============================================================
-- STATE STORE
-- Guarda apenas propriedades modificadas pelo otimizador.
-- ============================================================
local StateStore = {
    _storage = {} :: { [Instance]: { [string]: any } },

    save = function(self, instance: Instance, property: string, currentValue: any)
        local entry = self._storage[instance]
        if not entry then
            entry = {}
            self._storage[instance] = entry
        end
        if entry[property] == nil then
            entry[property] = currentValue
        end
    end,

    restoreAll = function(self)
        for instance, entry in pairs(self._storage) do
            for prop, value in pairs(entry) do
                pcall(function()
                    (instance :: any)[prop] = value
                end)
            end
        end
        self._storage = {}
    end,
}

